import streamlit as st
import numpy as np

st.set_page_config(page_title="Kükner Cryptology - Text Encryption", page_icon="🔐", layout="centered")

st.title("🔐 Kükner Kriptoloji - Metin Şifreleme Modülü")
st.markdown("### Formula: $\\left(\\frac{100}{19} \\times \\frac{\\pi}{19}\\right)^n$")
st.write("Bu arayüz, hassas metinlerinizi Kükner formülünün 207 basamaklı yüksek hassasiyetli anahtar akışıyla şifreler ve çözer.")

# Kullanıcıdan gizli metin alalım
gizli_metin = st.text_input("Şifrelenecek Metni Girin:", "Kükner Kriptoloji Savunma Sistemleri")

if st.button("🔒 Metni Şifrele ve Çöz"):
    if not gizli_metin:
        st.warning("Lütfen şifrelenecek bir metin girin.")
    else:
        with st.spinner("Şifreleme matrisleri uygulanıyor..."):
            pi = np.pi
            temel_katsayi = (100.0 / 19.0) * (pi / 19.0)
            
            # Anahtar akışı üretimi
            anahtar_akisi = []
            for n in range(1, len(gizli_metin) + 1):
                formul_degeri = np.power(temel_katsayi, n)
                hassas_str = f"{formul_degeri:.50f}".replace('.', '')
                bayt_deger = int(hassas_str[-4:]) % 256
                anahtar_akisi.append(bayt_deger)
                
            # Şifreleme (XOR)
            sifreli_baytlar = []
            for i, karakter in enumerate(gizli_metin):
                sifreli_karakter = ord(karakter) ^ anahtar_akisi[i]
                sifreli_baytlar.append(sifreli_karakter)
                
            sifreli_hex = ''.join([f'{b:02X}' for b in sifreli_baytlar])
            
            # Çözme (Decryption)
            cozulmus_karakterler = []
            for i, sifreli_karakter in enumerate(sifreli_baytlar):
                orijinal_karakter = chr(sifreli_karakter ^ anahtar_akisi[i])
                cozulmus_karakterler.append(orijinal_karakter)
                
            cozulmus_metin = ''.join(cozulmus_karakterler)
            
            st.success("İşlem Başarıyla Tamamlandı!")
            st.markdown(f"**Orijinal Metin:** `{gizli_metin}`")
            st.markdown(f"**Şifrelenmiş Hali (Hex):** `{sifreli_hex}`")
            st.markdown(f"**Çözülen Metin:** `{cozulmus_metin}`")
            st.balloons()
